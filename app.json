{
  "expo": {
    "name": "Rota do Croquete",
    "slug": "rota-do-croquete",
    "owner": "andrepjorge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "rotacroquete",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/dc582278-575b-4f8e-b83d-2202f7a70439",
      "enabled": true,
      "fallbackToCacheTimeout": 0
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF9F2"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Para fotografar croquetes",
        "NSPhotoLibraryUsageDescription": "Para adicionar fotos de croquetes",
        "NSLocationWhenInUseUsageDescription": "Para mostrar a tua localização no mapa"
      }
    },
    "android": {
      "package": "tech.sensei.rotadocroquete",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E67E22"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Para adicionar fotos de croquetes",
          "cameraPermission": "Para fotografar croquetes"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Para mostrar a tua localização no mapa"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "ndkVersion": "27.1.12297006",
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "jvmOptions": ["-Xmx4g", "-XX:MaxMetaspaceSize=2g", "-Dfile.encoding=UTF-8"]
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dc582278-575b-4f8e-b83d-2202f7a70439"
      }
    }
  }
}
